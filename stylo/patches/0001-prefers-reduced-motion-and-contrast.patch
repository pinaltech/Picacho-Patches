+/// https://drafts.csswg.org/mediaqueries-5/#prefers-reduced-motion
+fn eval_prefers_reduced_motion(context: &Context, query_value: Option<PrefersReducedMotion>) -> bool {
+    let preferred = context.device().prefers_reduced_motion();
+    match query_value {
+        Some(v) => preferred == v,
+        // In the boolean context, it matches any value but no-preference.
+        None => preferred != PrefersReducedMotion::NoPreference,
+    }
+}
+
+/// https://drafts.csswg.org/mediaqueries-5/#prefers-contrast
+fn eval_prefers_contrast(context: &Context, query_value: Option<PrefersContrast>) -> bool {
+    let preferred = context.device().prefers_contrast();
+    match query_value {
+        Some(v) => preferred == v,
+        None => preferred != PrefersContrast::NoPreference,
+    }
+}
