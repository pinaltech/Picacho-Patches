+        Capability::Atom(a) => a.eq_ignore_ascii_case("IMAP4rev2"),
+        _ => false,
+    });
+    if rev2 || capabilities.contains(&Capability::Imap4rev1) {
         Ok(capabilities)
     } else {
         Err(())
@@ -871,11 +876,19 @@ mod tests {
             }
         );
 
