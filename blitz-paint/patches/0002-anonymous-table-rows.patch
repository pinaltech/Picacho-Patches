An anonymous row (blitz-dom's 0005) paints no row background: its node is its one cell.

diff --git a/src/render/background.rs b/src/render/background.rs
index 65b72f6..943d2f5 100644
--- a/src/render/background.rs
+++ b/src/render/background.rs
@@ -267,7 +267,11 @@ impl ElementCx<'_, '_> {
             .map(|row| {
                 [
                     row.group.and_then(background_color),
-                    background_color(row.node_id),
+                    // An anonymous row's node is its one cell, which paints
+                    // its own background.
+                    (!row.anonymous)
+                        .then(|| background_color(row.node_id))
+                        .flatten(),
                 ]
             })
             .collect();
